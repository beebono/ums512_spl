/* Board config fragment for ums512_1h10 (sharkl5pro), CFW build.
 *
 * SPL boots Linux directly from the eMMC "boot" partition (see
 * chipram/nand_spl/linux_boot.c): no SML, TOS, teecfg or u-boot, so no secure
 * boot and no firewall setup. Signed like signed-open so a fused BootROM
 * accepts it. The SML/TOS addresses stay defined only because shared code
 * still references them.
 */
#define CONFIG_SML_LDADDR_START 0x94000000
#define CONFIG_TOS_LDADDR_START 0x94060000
#define CONFIG_TEECFG_LDADDR_START 0x94040000
#define CONFIG_SML_TOS_RUNNING_SIZE 0x2000000
#define CONFIG_SEC_MEM_SIZE 0x2000000
#undef CONFIG_DUAL_BACKUP
#undef CONFIG_SD_BOOT
#define CONFIG_SPL_BOOT_LINUX
